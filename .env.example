# Copy to .env and fill in locally. Never commit .env.
# Mainnet stays off unless the process is also started with
# --i-understand-this-is-real-money. An env file alone cannot enable it.

LORADDEX_LTC_NETWORK=testnet4
LORADDEX_XMR_NETWORK=stagenet

# RPC endpoints. Passwords stay here, never in the repo and never in logs.
LTC_RPC_URL=http://127.0.0.1:19332
LTC_RPC_USER=
LTC_RPC_PASSWORD=
XMR_WALLET_RPC_URL=http://127.0.0.1:38083

# Channel 1 pre-shared key. This is a spam gate, not confidentiality.
CHANNEL1_PSK=

# Key for the encrypted swap journal (decision D5). Leave empty until that path exists.
SWAP_JOURNAL_KEY=
